@*
    The frame around every page: the browser tab's title, the menu at the top and
    the footer at the bottom. Each page's own words appear where @RenderBody() is.
    Change "Team Name", "FTC", "#0" and the logo below to your team's.
*@
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The words in the browser tab: the page's own title, then your team's name. -->
    <title>@ViewData["Title"] | Team Name</title>
    <!-- What search engines and link previews say about your site. -->
    <meta name="description" content="FTC Team #0 Team Name at Pleasant Valley High School. One sentence about what your team is about." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Team Name | FTC Team #0" />
    <meta property="og:description" content="FTC Team #0 Team Name at Pleasant Valley High School." />
    <meta name="theme-color" content="#070b1f" />
    <!-- The little picture in the browser tab: your team's logo. -->
    <link rel="icon" href="/images/pv-logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<!-- --accent is your team's color, used for borders and highlights. -->
<body style="--accent: #8b5cf6">
    <a class="skip" href="#main">Skip to content</a>

    <header class="header">
        <div class="container bar">
            <a class="brand" href="/">
                <!-- Your team's logo (put the file in wwwroot/images/). The background suits most logos; use #000000 for logos drawn on black. -->
                <img src="/images/pv-logo.png" alt="" width="40" height="40" style="background: #ffffff" />
                <span>Team Name</span>
            </a>
            <!-- The menu. To add a page to it, copy one <li> line and change the address and the words. -->
            <nav aria-label="Main">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="https://www.firstpvrobotics.com">PV Robotics ↗</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <a class="pv" href="https://www.firstpvrobotics.com">
                <img src="/images/pv-logo.png" alt="" width="44" height="44" />
                <span>Part of Pleasant Valley FIRST Robotics</span>
            </a>
            <img class="footer-first" src="/images/first-logo.png" alt="FIRST" width="111" height="70" />
        </div>
        <!-- The year fills itself in. Change the team name and number. -->
        <div class="container legal muted">© @DateTime.Now.Year Team Name · FTC Team #0</div>
    </footer>
</body>
</html>
