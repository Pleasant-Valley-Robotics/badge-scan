@page
@{
    ViewData["Title"] = "Home";
}
@*
    The home page: https://<team number>.firstpvrobotics.com/
    Everything below is plain HTML. Change the words between the tags to your team's.
    The notes in <!-- --> tell you what goes where; visitors don't see them.
*@

<section class="team-hero">
    <div class="container hero-grid">
        <div>
            <!-- FTC or FRC, your team number, and the year you started (delete " · Since 2020" if you're not sure). -->
            <span class="eyebrow">FTC Team #0 · Since 2020</span>
            <!-- Your team's name. -->
            <h1>Team Name</h1>
            <!-- One sentence about what your team is about. -->
            <p class="tagline">One sentence about what your team is about.</p>
            <!-- Short facts shown as bubbles. Add or delete <li> lines. -->
            <ul class="chips">
                <li>A short fact</li>
                <li>Another fact</li>
                <li>An award you won</li>
            </ul>
        </div>
        <!-- Your logo. Put the file in wwwroot/images/ and change the src. Use background: #000000 for logos drawn on black. -->
        <div class="hero-logo" style="background: #ffffff">
            <img src="/images/pv-logo.png" alt="Team Name logo" />
        </div>
    </div>
</section>

<section class="section">
    <div class="container story">
        <!-- Your team's story. One <p> per paragraph. -->
        <div class="prose">
            <p>Write a few sentences about your team here: when it started, what you build, and what you're proud of.</p>
            <p>A second paragraph, if you want one.</p>
        </div>
        <aside class="card connect">
            <h3>Connect with Team Name</h3>
            <!-- Your team's email address, in both places on the next line. Delete the line if you don't have one. -->
            <p><a href="mailto:team@example.com">team@example.com</a></p>
            <!-- Links to your team's accounts. Change each address and name; delete the ones you don't use. -->
            <ul class="pills">
                <li><a href="https://www.instagram.com/" rel="noopener" target="_blank">Instagram</a></li>
                <li><a href="https://www.youtube.com/" rel="noopener" target="_blank">YouTube</a></li>
            </ul>
        </aside>
    </div>
    <!-- A team photo: put the file in wwwroot/images/ and change the src, then delete the
         "PHOTO START" line and the "PHOTO END" line so it shows. The alt words describe the
         photo for people who can't see it. -->
    <!-- PHOTO START
    <div class="container">
        <figure class="photo">
            <img src="/images/team-photo.jpg" alt="Our team at the state championship" loading="lazy" />
            <figcaption class="muted">Our team at the state championship</figcaption>
        </figure>
    </div>
    PHOTO END -->
</section>

<!-- A group of cards. Copy the whole <section> to add another group; copy one card's <div> to add a card. -->
<section class="section section--alt">
    <div class="container">
        <div class="section-head"><span class="eyebrow">How we work</span><h2>Departments</h2></div>
        <div class="grid grid--3">
            <div class="card item"><h3>Build</h3><p class="muted">What this group does.</p></div>
            <div class="card item"><h3>Programming</h3><p class="muted">What this group does.</p></div>
            <div class="card item"><h3>Outreach</h3><p class="muted">What this group does.</p></div>
        </div>
    </div>
</section>

<!-- Your outreach projects, one card each. -->
<section class="section section--alt">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Outreach</span>
            <h2>In the community</h2>
            <p class="lede">Some of the ways Team Name shares STEM beyond the competition field.</p>
        </div>
        <div class="grid grid--3">
            <div class="card item"><h3>A project</h3><p class="muted">What you did, who it was for, and what happened.</p></div>
            <div class="card item"><h3>Another project</h3><p class="muted">What you did, who it was for, and what happened.</p></div>
        </div>
    </div>
</section>
