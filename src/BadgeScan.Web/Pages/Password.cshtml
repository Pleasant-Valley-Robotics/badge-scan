@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = "Your password";
}
<section class="section">
    <div class="container narrow-form">
        <div class="section-head">
            <span class="eyebrow">@(Model.Required ? "One more step" : "Your account")</span>
            <h2>Choose your password</h2>
            @if (Model.Required)
            {
                <p class="muted">You signed in with a temporary password. Choose your own to carry on. It needs at least @AccountService.MinPasswordLength characters; a short sentence is easy to remember.</p>
            }
        </div>
        @if (Model.Error is not null)
        {
            <p class="notice notice--error" role="alert">@Model.Error</p>
        }
        <form method="post" class="card stack">
            <label>@(Model.Required ? "Temporary password" : "Current password")
                <input name="Current" type="password" autocomplete="current-password" required autofocus />
            </label>
            <label>New password
                <input name="Chosen" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required />
            </label>
            <label>New password again
                <input name="Repeated" type="password" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required />
            </label>
            <button class="btn btn--primary" type="submit">Save password</button>
        </form>
    </div>
</section>
